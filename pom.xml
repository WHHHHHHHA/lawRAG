<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- 注意：本工程为 Java 17 / Spring Boot 3.3 / Spring AI 1.0 独立服务，
	     与 epointbid8 平台（Java 8 / Spring Boot 2.3）技术栈不同。
	     【勿将本模块加入根 pom 的 <modules>】，否则会被 Java 8 编译链吞掉。
	     与平台的唯一耦合是 HTTP 协议（由 dzjy-api/ztb-aiks-impl 转发）。 -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.3.12</version>
		<relativePath />
	</parent>

	<groupId>com.epint.ztb.aiks</groupId>
	<artifactId>dzjy-aiks</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>dzjy-aiks</name>
	<description>AI 智能问答（法规咨询）微服务 - 服务代理机构日常法规咨询</description>

	<properties>
		<java.version>17</java.version>
		<maven.compiler.release>17</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- Spring AI 1.0.x GA，统一由 BOM 管理版本 -->
		<spring-ai.version>1.0.0</spring-ai.version>
		<!-- MyBatis-Plus：Spring Boot 3.x 必须使用 spring-boot3-starter -->
		<mybatis-plus.version>3.5.7</mybatis-plus.version>
		<bucket4j.version>8.10.1</bucket4j.version>
	</properties>

	<modules>
		<module>aiks-server</module>
	</modules>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

</project>
